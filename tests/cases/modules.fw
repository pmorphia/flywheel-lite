geo.Shape s = geo.Rect(1.0, 1.0)
print s.area()
function total(geo.Shape[] items) returns double
    var sum = 0.0
    for item in items do
        sum += item.area()
    end
    return sum
end
print total([r, geo.make(1.0, 4.0)]), geo.created
