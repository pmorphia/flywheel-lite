class Animal
    string name
    int legs = 4
    function speak() returns string
        return "..."
    end
    function describe() returns string
        return "{this.name} ({this.legs} legs) says {this.speak()}"
    end
end

class Bird extends Animal
    bool flies = true
    constructor(string name)
        super.constructor(name, 2)
    end
    function speak() returns string
        return "tweet"
    end
end

class Dog extends Animal
    function speak() returns string
        return "woof"
    end
end

Animal[] zoo = [Bird("Polly"), Dog("Rex"), Animal("Generic")]
for a in zoo do
    print a.describe()
end
print zoo[0] is Bird, zoo[1] is Bird, zoo[1] as Dog, (zoo[1] as Bird?) == null

class Vec
    readonly int x
    readonly int y
    function operator +(Vec o) returns Vec
        return Vec(this.x + o.x, this.y + o.y)
    end
    function operator -() returns Vec
        return Vec(-this.x, -this.y)
    end
    function operator ==(Vec o) returns bool
        return this.x == o.x and this.y == o.y
    end
    function operator <(Vec o) returns bool
        return this.x * this.x + this.y * this.y < o.x * o.x + o.y * o.y
    end
    function hash() returns int
        return this.x * 31 + this.y
    end
    function equals(Vec o) returns bool
        return this.x == o.x and this.y == o.y
    end
    function to_string returns string
        return "<{this.x},{this.y}>"
    end
end
var a = Vec(1, 2)
var b = a + Vec(3, 4)
print a, b, -a, a == Vec(1, 2), a != b, a < b, b > a, a >= b
map<Vec, string> names = {Vec(0, 0): "origin"}
names[Vec(1, 1)] = "diagonal"
print names[Vec(0, 0)], Vec(1, 1) in names, names.length

class Counter
    int value = 0
    int[] history = []
    function add(int n) returns int
        this.value += n
        this.history.push(n)
        return this.value
    end
end
var c1 = Counter()
var c2 = Counter()
c1.add(5)
var adder = c1.add
adder(2)
print c1.value, c1.history, c2.history, [1, 2, 3].map(c2.add)

class Temperature
    double celsius
    string label = "temp"
    constructor(double fahrenheit)
        this.celsius = (fahrenheit - 32.0) * 5.0 / 9.0
    end
end
print Temperature(212.0).celsius, Temperature(32.0).label

class Countdown
    int n
    function next() returns int?
        if this.n == 0 do
            return null
        end
        this.n -= 1
        return this.n + 1
    end
end
for i in Countdown(3) do
    print "tick", i
end

class Box<T>
    T value
    function map<U>(function(T) returns U f) returns Box<U>
        return Box<U>(f(this.value))
    end
end
print Box(21).map(function(int x) => x * 2).value

class Node
    string name
    Node? next = null
end
var n1 = Node("a")
n1.next = Node("b")
print n1.next.name, n1
var make = Node
print make("built").name
