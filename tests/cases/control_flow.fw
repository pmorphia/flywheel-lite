function find(int[] xs, int target) returns int
    for i, x in xs do
        try
            if x == target do
                return i
            end
        finally
            print "checked", x
        end
    end
    return -1
end
print find([4, 5, 6], 5)

var log = ""
for i in 0..<6 do
    try
        if i == 1 do
            continue
        end
        if i == 4 do
            break
        end
        log += "{i}"
    finally
        log += "."
    end
end
print log

function nested() returns string
    try
        try
            throw ValueError("inner")
        catch ValueError e
            throw RuntimeError("outer from " + e.message)
        finally
            print "inner finally"
        end
    catch RuntimeError e
        return e.message
    finally
        print "outer finally"
    end
end
print nested()

var count = 0
while true do
    count += 1
    if count >= 3 do
        break
    end
end
print count

function defers() returns int
    var steps = [0]
    defer print "deferred", steps
    for i in 1..3 do
        defer steps.push(i)
    end
    return steps.length
end
print defers()

try
    throw "Custom" "named error"
catch "Custom" e
    print e.name, e.message
end

try
    int[] empty = []
    print empty[3]
catch IndexError e
    print "index:", e.message
end
